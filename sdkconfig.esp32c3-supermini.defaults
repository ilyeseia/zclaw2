# ESP32-C3 Super Mini board preset
#
# Board: ESP32-C3FH4 (4MB embedded flash), native USB Serial/JTAG, no USB-UART bridge.
# Exposed GPIOs: 0-10, 20, 21.
#   GPIO8  -> onboard LED (active low on most boards; strapping pin)
#   GPIO9  -> BOOT button (strapping pin, used as the factory-reset button)
#   GPIO2  -> strapping pin
#   GPIO20/21 -> UART0 RX/TX, GPIO18/19 -> USB D-/D+ (not exposed for tools)

# Target
CONFIG_IDF_TARGET="esp32c3"

# GPIO tool safety
# Skip GPIO2 and GPIO9 (boot strapping / BOOT button) and the UART/USB pins.
# GPIO8 stays allowed so the assistant can drive the onboard LED.
CONFIG_ZCLAW_GPIO_ALLOWED_PINS="0,1,3,4,5,6,7,8,10"

# Factory reset: hold the BOOT button (GPIO9) during startup.
CONFIG_ZCLAW_FACTORY_RESET_PIN=9
CONFIG_ZCLAW_FACTORY_RESET_HOLD_MS=5000

# Many Super Mini clones have a poor antenna matching network and drop or fail
# to join WiFi at full TX power. 34 = 8.5 dBm (units of 0.25 dBm).
CONFIG_ZCLAW_WIFI_MAX_TX_POWER=34
